<?xml version="1.0"?>
<ruleset name="TechByIt SMTP">
    <description>WordPress Core rules for provider, settings, REST, and mail services. PSR-4 class filenames are intentional.</description>
    <rule ref="WordPress-Core">
        <exclude name="WordPress.Files.FileName" />
    </rule>
    <file>src/Providers</file>
    <file>src/Plugin.php</file>
    <file>src/Settings</file>
    <file>src/Support</file>
    <file>src/Rest/ApiResponse.php</file>
    <file>src/Rest/ProviderController.php</file>
    <file>src/Rest/SettingsController.php</file>
    <file>src/Rest/TestMailController.php</file>
    <file>src/Mail</file>
</ruleset>
